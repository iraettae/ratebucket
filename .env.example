# Copy to .env for the examples. Never commit .env; it is in .gitignore.
#
# The library core needs none of this. Only the openai_compat adapter and the
# examples read these, and the benchmark reads none of them at all: it runs
# against the fake provider in this repository, with no keys, no money and no
# network beyond localhost.

RATEBUCKET_BASE_URL=https://api.openai.com/v1
RATEBUCKET_API_KEY=sk-replace-me
